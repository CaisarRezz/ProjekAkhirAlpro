  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #FFFFFF;
    font-family: "Segoe UI", "Inter", sans-serif;
}

QLabel {
    color: #1F2937;
    font-size: 13px;
    font-weight: 600;
}

QLabel#lblDialogTitle {
    font-size: 22px;
    font-weight: 700;
    color: #111827;
}

QLabel#lblDialogSubtitle {
    font-size: 14px;
    font-weight: 400;
    color: #6B7280;
}

QPushButton#btnClose {
    background: transparent;
    border: none;
    color: #6B7280;
    font-size: 16px;
    border-radius: 6px;
}

QPushButton#btnClose:hover {
    background-color: #F3F4F6;
    color: #111827;
}

QFrame#lineTop, QFrame#lineBottom {
    color: #E5E7EB;
    background-color: #E5E7EB;
    max-height: 1px;
    border: none;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 24px;
    font-size: 14px;
    color: #111827;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus {
    border: 1.5px solid #2E8B57;
}

QComboBox::drop-down, QDateEdit::drop-down {
    border: none;
    width: 28px;
}

QFrame#infoBanner {
    background-color: #F3F5F4;
    border-radius: 8px;
}

QLabel#lblInfoIcon {
    color: #2E8B57;
    font-size: 16px;
    font-weight: bold;
}

QLabel#lblInfoText {
    color: #6B7280;
    font-size: 13px;
    font-weight: 400;
}

QPushButton#btnCancel {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    color: #111827;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
    min-height: 26px;
}

QPushButton#btnCancel:hover {
    background-color: #F9FAFB;
}

QPushButton#btnAddFood {
    background-color: #2E8B57;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 28px;
    min-height: 26px;
}

QPushButton#btnAddFood:hover {
    background-color: #257347;
}

QPushButton#btnAddFood:pressed {
    background-color: #1E5E3A;
}</string>
